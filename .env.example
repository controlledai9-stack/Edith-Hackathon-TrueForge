# Required model provider
GROQ_API_KEY=replace_with_your_key

# Optional research and image providers
TAVILY_API_KEY=
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-3.1-pro-preview
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# TrueForge harness
TRUEFORGE_ENABLED=true
TRUEFORGE_BASE_URL=http://localhost:8790
TRUEFORGE_TOKEN=
TRUEFORGE_MODEL=groq/qwen3-6-27b
TRUEFORGE_MCP_URL=http://127.0.0.1:8000/mcp/
TRUEFORGE_FALLBACK_ENABLED=true
TRUEFORGE_AUTO_BOOTSTRAP=false
TRUEFORGE_CODE_SANDBOX_ENABLED=false

# Optional Google OAuth connection
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/oauth/google/callback

# Optional LinkedIn API connection
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8000/oauth/linkedin/callback

# Optional browser worker limits
UNIVERSAL_BROWSER_MAX_STEPS=24
UNIVERSAL_BROWSER_AUTH_WAIT_SECONDS=600
